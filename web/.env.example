# Copy to .env.local. Both values are read only on the server (by the /api proxy).

# Where the FastAPI backend listens (`archiver serve`).
BACKEND_URL=http://127.0.0.1:8137

# Must match HUB_WRITE_TOKEN in the backend's .env when that is set; leave empty otherwise.
# Attached to write requests server-side, never sent to the browser.
HUB_WRITE_TOKEN=
