# Copy to .env.local. All values are read only on the server.

# Where the FastAPI backend listens (`archiver serve`).
BACKEND_URL=http://127.0.0.1:8137

# Must match HUB_WRITE_TOKEN on the backend when that is set; leave empty otherwise.
# Attached server-side to every request the proxy forwards, never sent to the browser.
HUB_WRITE_TOKEN=

# Site password. When set, every page and /api call needs a sign-in (see proxy.ts).
# Set it on Vercel; leave empty for local development.
SITE_PASSWORD=
